; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="战斗系统"
run/main_scene="res://world/map/MainHighlandMap.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameState="*res://core/save/game_state.gd"
CameraCtrl="*res://core/camera/camera_controller.gd"
Dialogue="*res://core/dialogue/dialogue_system.gd"
StoryDB="*res://core/story/story_database.gd"
StoryRunner="*res://core/story/story_runner.gd"
StoryTrigger="*res://core/story/trigger_manager.gd"
CardDB="*res://core/card/card_database.gd"
EnemyDB="*res://core/battle/enemy_database.gd"
NpcDB="*res://core/world/npc_database.gd"
EquipDB="*res://core/equipment/equipment_database.gd"
BuffDB="*res://core/effect/buff_database.gd"
ItemDB="*res://core/items/item_database.gd"
PathDB="*res://core/progression/path_database.gd"
CardDropDB="*res://core/card/card_drop_database.gd"
EnemyPackDB="*res://core/battle/enemy_pack_database.gd"
QuestDB="*res://core/quest/quest_database.gd"
QuestSystem="*res://core/quest/quest_system.gd"
MCPGameBridge="res://addons/godot_mcp/game_bridge/mcp_game_bridge.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp/plugin.cfg")

[godot_mcp]

bind_mode=0
custom_bind_ip=""
port_override_enabled=false
port_override=6550

[input]

